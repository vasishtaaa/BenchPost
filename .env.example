# Environment configuration for Benchpost

# Application Settings
ENVIRONMENT=development
PROJECT_NAME="Benchpost"
API_V1_STR="/api/v1"
SECRET_KEY="supersecret_campusloop_jwt_dev_key_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Defaults to SQLite for local portable execution.
# To use PostgreSQL, set: postgresql+psycopg://username:password@localhost:5432/campusloop
DATABASE_URL="sqlite:///./campusloop.db"

# University Email Constraint
# Set to false in dev/demo mode so test accounts can register with any valid email.
REQUIRE_UNIVERSITY_DOMAIN=false
ALLOWED_UNIVERSITY_DOMAINS=["edu", "ac.in", "university.edu"]

# CORS Origins
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
